<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.RichenganpaiDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.RichenganpaiEntity" id="richenganpaiMap">
        <result property="huodongmingcheng" column="huodongmingcheng"/>
        <result property="shijian" column="shijian"/>
        <result property="dizhi" column="dizhi"/>
        <result property="neirong" column="neirong"/>
        <result property="zhuyishixiang" column="zhuyishixiang"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.RichenganpaiView" >

		SELECT  richenganpai.* FROM richenganpai  richenganpai 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.RichenganpaiView" >
		SELECT * FROM richenganpai  richenganpai <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
